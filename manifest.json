{
  "manifest_version": 3,
  "name": "AdaptaPE Lite",
  "version": "3.0",
  "description": "__MSG_descripcion__",
  "author": "Rodrigo Alejandro Apcho Aliaga (TheAlejo160)",
  "homepage_url": "https://adaptape.thealejo-dev.cc",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_panel__",
    "default_icon": {
      "16": "AdaptaPELite.png",
      "48": "AdaptaPELite.png",
      "128": "AdaptaPELite.png"
    }
  },
  "icons": {
    "16": "AdaptaPELite.png",
    "48": "AdaptaPELite.png",
    "128": "AdaptaPELite.png"
  },
  "chrome_url_overrides": {
    "newtab": "nueva_pestana.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "system.display",
    "offscreen",
    "scripting",
    "tts",
    "search",
    "topSites",
    "bookmarks",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "sitios.js",
        "textos.js",
        "clases/FiltrosDaltonismo.js",
        "clases/VoiceAssistant.js",
        "mascotas/Mascota.js",
        "content_script.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "clases/FiltrosDaltonismo.js",
        "filtros_frames.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_end"
    }
  ],
  "minimum_chrome_version": "119",
  "web_accessible_resources": [
    {
      "resources": [
        "mascotas/motor.js",
        "mascotas/*/cuy.json",
        "mascotas/*/atlas.webp"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "default_locale": "es"
}
